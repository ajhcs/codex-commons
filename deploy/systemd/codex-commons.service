[Unit]
Description=Codex Commons personal dogfood
After=network-online.target
Wants=network-online.target

[Service]
Type=notify
NotifyAccess=main
# Startup runs migrations/reconciliation and waits for the first readiness
# snapshot before READY=1. Three minutes is finite but leaves room for a cold
# managed Codex probe; a timeout remains a startup failure, not a green state.
TimeoutStartSec=180
WatchdogSec=60
EnvironmentFile=%h/.config/codex-commons/dogfood.env
# Start through the stable launcher so current is resolved once and this
# process stays pinned to that exact verified release directory.
ExecStart=/bin/sh %h/.local/libexec/codex-commons/commons-launch.sh
Restart=on-failure
RestartSec=3
TimeoutStopSec=30
KillMode=mixed
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=read-only
ReadWritePaths=%h/.local/state/codex-commons %h/.codex
ProtectKernelTunables=true
ProtectControlGroups=true
LockPersonality=true
RestrictRealtime=true
TasksMax=256
MemoryMax=2G
LimitNOFILE=4096
UMask=0077

[Install]
WantedBy=default.target
