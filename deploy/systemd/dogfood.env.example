COMMONS_LISTEN=127.0.0.1:8088
COMMONS_PUBLIC_ORIGIN=https://commons.plumbob.lan
# Absolute regular database file. The canonical parent must be a real
# non-symlink directory owned by the effective uid/gid and not group or other
# writable. The destination is either absent for first-deploy cleanup or a
# regular non-symlink file, mode 0600, owned by that uid/gid. A dangling
# symlink is not absent.
COMMONS_DB=/home/USER/.local/state/codex-commons/commons.sqlite3
COMMONS_BACKUP_DIR=/home/USER/.local/state/codex-commons/backups
# Private directory for sanitized deployment-attempt receipts. The existing
# parent must be owned by the effective uid/gid and not group or other writable.
# The leaf must be a real non-symlink direct child, mode 0700, owned by that
# uid/gid. The receipt is one regular non-symlink file, mode 0600. Override
# only with a path that satisfies those rules. Do not store secrets, database
# paths, or prompts.
COMMONS_DEPLOY_STATE_DIR=/home/USER/.local/state/codex-commons/deploy
COMMONS_RELEASE_ROOT=/home/USER/.local/lib/codex-commons
# current is the mutable pointer only. The stable launcher resolves it once
# and overwrites COMMONS_RELEASE_DIR, COMMONS_WEB_DIR, COMMONS_CODEX_BIN, and
# COMMONS_RELEASE_IDENTITY_FILE with exact paths from that pinned directory.
COMMONS_RELEASE_IDENTITY_FILE=/home/USER/.local/lib/codex-commons/current/VERSION
COMMONS_RELEASE_DIR=/home/USER/.local/lib/codex-commons/current
COMMONS_WEB_DIR=/home/USER/.local/lib/codex-commons/current/web
COMMONS_CODEX_BIN=/home/USER/.local/lib/codex-commons/current/bin/codex
COMMONS_CODEX_SHA256=cb0a15567e9a60a5820d54b0f6ae86d504dc3805c1eab21a47f70e3eb7b73a40
COMMONS_CODE_MODE_HOST_SHA256=00ecf5d040865b97884c488883abd342581c2a432debe7a54e4646bceee3d2d6
COMMONS_CODEX_BWRAP_SHA256=77360cb751ccedc5971391444ac86a8a33c15b04d6b4a6fe45f5d25496e62c4c
COMMONS_CODEX_ZSH_SHA256=67faaaa89242c4a332e16e508a1977cffc24bf7fca31d4411cdfd101f3831ef3
COMMONS_CODEX_RG_SHA256=e62198eb19b136b88c330af83647b5a962cb99b6b1f066758568f12de1974849
COMMONS_CODEX_PACKAGE_SHA256=00f66f11cc7d5c4133d500b4aae6ed4975608d6b040eefd56dc1ff343566e8cf
COMMONS_CODEX_VERSION=0.147.0
# Optional-safe default: false keeps Commons service/read-only health available
# during a Codex outage. Set true only when READY/watchdog must require the
# managed Codex process, signed-in account, compatible model, and no persistence
# latch; historian claims remain gated while that required capability is absent.
COMMONS_REQUIRE_CODEX_READY=false
COMMONS_NATIVE_ARCHAEOLOGY_APPLY=false
COMMONS_CODEX_AUTH=true
COMMONS_EXPERIMENTAL_HISTORIAN_TASKS=true
COMMONS_ALLOW_FIRST_CODEX_BIND_LAN=false
# Generate a private high-entropy value and keep the installed env file mode 0600.
COMMONS_CODEX_BINDING_KEY_FILE=/home/USER/.config/codex-commons/binding.key
